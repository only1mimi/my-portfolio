* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #0b1120;
    color: #e5e7eb;
    line-height: 1.6;
}

header {
    background: #111827;
    padding: 25px 10%;
    text-align: center;
    border-bottom: 1px solid #263449;
}

header h1 {
    color: #38bdf8;
    font-size: 2.5rem;
    margin-bottom: 8px;
}

header p {
    color: #cbd5e1;
}

nav {
    margin-top: 20px;
}

nav a {
    color: #e5e7eb;
    text-decoration: none;
    margin: 0 12px;
    font-weight: bold;
}

nav a:hover {
    color: #38bdf8;
}

main {
    width: 85%;
    max-width: 1000px;
    margin: auto;
}

section {
    padding: 70px 0;
    border-bottom: 1px solid #1e293b;
}

section h2 {
    color: #38bdf8;
    font-size: 2rem;
    margin-bottom: 20px;
}

section p {
    color: #cbd5e1;
}

ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    list-style: none;
}

li {
    background: #111827;
    padding: 15px;
    border: 1px solid #263449;
    border-radius: 8px;
}

article {
    background: #111827;
    padding: 25px;
    margin-bottom: 20px;
    border-radius: 10px;
    border: 1px solid #263449;
}

article h3 {
    color: #7dd3fc;
    margin-bottom: 10px;
}

footer {
    text-align: center;
    padding: 30px;
    background: #111827;
    color: #94a3b8;
}

@media (max-width: 600px) {
    header h1 {
        font-size: 2rem;
    }

    nav a {
        display: inline-block;
        margin: 5px;
    }

    main {
        width: 90%;
    }
}